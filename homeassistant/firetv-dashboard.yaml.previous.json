  {
   "title": "Voice",
   "path": "voice",
   "icon": "mdi:microphone",
   "background": "linear-gradient(178deg, #151C27 0%, #0B0E13 100%) #0B0E13",
   "cards": [
    {
     "type": "vertical-stack",
     "cards": [
      {
       "type": "entities",
       "title": "Say to Alexa",
       "show_header_toggle": false,
       "card_mod": {
        "style": "ha-card {\n  background: rgba(255,255,255,0.05);\n  border: none;\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);\n  color: #CFE6F2;\n  --primary-text-color: #E3EDF5;\n  --secondary-text-color: #93A1B0;\n  --paper-item-icon-color: #8ADAF2;\n}\n.card-header {\n  color: #CFE6F2 !important;\n  font-size: 15px;\n  font-weight: 600;\n}\n"
       },
       "entities": [
        {
         "entity": "input_text.fire_tv_voice",
         "name": "Phrase",
         "icon": "mdi:microphone-message"
        }
       ]
      },
      {
       "type": "horizontal-stack",
       "cards": [
        {
         "type": "custom:button-card",
         "template": "ftv_action",
         "name": "Speak",
         "icon": "mdi:send",
         "tap_action": {
          "action": "call-service",
          "service": "script.fire_tv_speak"
         }
        },
        {
         "type": "custom:button-card",
         "template": "ftv_action",
         "name": "Hold to talk",
         "icon": "mdi:microphone",
         "styles": {
          "card": [
           {
            "background": "rgba(79,195,232,0.16)"
           }
          ]
         },
         "tap_action": {
          "action": "url",
          "url_path": "https://192.168.2.15:8443/voice.html"
         }
        }
       ]
      },
      {
       "type": "entities",
       "title": "Keyboard",
       "show_header_toggle": false,
       "card_mod": {
        "style": "ha-card {\n  background: rgba(255,255,255,0.05);\n  border: none;\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);\n  color: #CFE6F2;\n  --primary-text-color: #E3EDF5;\n  --secondary-text-color: #93A1B0;\n  --paper-item-icon-color: #8ADAF2;\n}\n.card-header {\n  color: #CFE6F2 !important;\n  font-size: 15px;\n  font-weight: 600;\n}\n"
       },
       "entities": [
        {
         "entity": "input_text.fire_tv_keyboard",
         "name": "Type into search",
         "icon": "mdi:keyboard"
        }
       ]
      },
      {
       "type": "custom:button-card",
       "template": "ftv_action",
       "name": "Send text",
       "icon": "mdi:keyboard-return",
       "tap_action": {
        "action": "call-service",
        "service": "script.fire_tv_type_text"
       }
      }
     ]
    }
   ]
  },
  {
   "title": "Apps",
   "path": "apps",
   "icon": "mdi:apps",
   "background": "linear-gradient(178deg, #151C27 0%, #0B0E13 100%) #0B0E13",
   "cards": [
    {
     "type": "vertical-stack",
     "cards": [
      {
       "type": "custom:config-template-card",
       "entities": [
        "sensor.fire_tv_apps",
        "input_select.fire_tv_target"
       ],
       "card": {
        "type": "grid",
        "columns": 3,
        "square": false,
        "cards": "${((states['sensor.fire_tv_apps'] && states['sensor.fire_tv_apps'].attributes.apps) || []).map(function (a) { return { type: 'custom:button-card', template: 'ftv_app', name: a.name, custom_fields: { pic: '<img src=\"' + a.icon_url + '\" alt=\"\" style=\"width:46px;height:46px;border-radius:11px;object-fit:cover;display:block;\">' }, tap_action: { action: 'call-service', service: 'script.fire_tv_launch_package', service_data: { package: a.package } } }; })}"
       }
      },
      {
       "type": "custom:button-card",
       "template": "ftv_action",
       "name": "Refresh app list from device",
       "icon": "mdi:refresh",
       "styles": {
        "name": [
         {
          "font-size": "12px"
         },
         {
          "color": "#93A1B0"
         }
        ],
        "icon": [
         {
          "color": "#93A1B0"
         }
        ]
       },
       "tap_action": {
        "action": "call-service",
        "service": "script.fire_tv_send_command",
        "service_data": {
         "command": "apps_sync"
        }
       }
      }
     ]
    }
   ]
