{
 "button_card_templates": {
  "ftv_base": {
   "color_type": "card",
   "show_icon": true,
   "show_name": false,
   "styles": {
    "card": [
     {
      "background": "rgba(255,255,255,0.05)"
     },
     {
      "border-radius": "14px"
     },
     {
      "border": "none"
     },
     {
      "box-shadow": "inset 0 1px 0 rgba(255,255,255,0.06)"
     },
     {
      "height": "52px"
     }
    ],
    "icon": [
     {
      "width": "23px"
     },
     {
      "color": "#AFBDCD"
     }
    ]
   },
   "extra_styles": "ha-card {\n  transition: transform .1s ease, background .1s ease,\n              box-shadow .1s ease, filter .1s ease;\n}\n/* the press: shrink under the finger and flare cyan */\nha-card:active {\n  transform: scale(0.91);\n  background: rgba(79,195,232,0.22) !important;\n  box-shadow: 0 0 16px rgba(79,195,232,0.45),\n              inset 0 1px 0 rgba(255,255,255,0.08) !important;\n  filter: brightness(1.3);\n}\n@media (prefers-reduced-motion: reduce) {\n  ha-card { transition: none; }\n  ha-card:active { transform: none; }\n}\n"
  },
  "ftv_pad": {
   "template": "ftv_base",
   "styles": {
    "card": [
     {
      "background": "radial-gradient(circle at 50% 35%, #222B39, #151B25)"
     },
     {
      "border-radius": "50%"
     },
     {
      "width": "66px"
     },
     {
      "height": "66px"
     },
     {
      "margin": "0 auto"
     },
     {
      "box-shadow": "inset 0 1px 0 rgba(255,255,255,0.07)"
     }
    ],
    "icon": [
     {
      "width": "26px"
     },
     {
      "color": "#C3D0DE"
     }
    ]
   },
   "extra_styles": "ha-card { transition: transform .1s ease, filter .1s ease; }\nha-card:active {\n  transform: scale(0.88);\n  filter: brightness(1.7) drop-shadow(0 0 12px rgba(79,195,232,0.85));\n}\n"
  },
  "ftv_ok": {
   "template": "ftv_pad",
   "show_name": true,
   "show_icon": false,
   "name": "OK",
   "styles": {
    "card": [
     {
      "background": "linear-gradient(160deg,#22303F,#141B25)"
     },
     {
      "width": "92px"
     },
     {
      "height": "92px"
     },
     {
      "box-shadow": "inset 0 1px 0 rgba(255,255,255,0.1), 0 0 0 1px rgba(255,255,255,0.05)"
     }
    ],
    "name": [
     {
      "font-size": "13px"
     },
     {
      "font-weight": 600
     },
     {
      "letter-spacing": "0.14em"
     },
     {
      "color": "#D3E8F4"
     }
    ]
   }
  },
  "ftv_gap": {
   "color_type": "card",
   "show_icon": false,
   "show_name": false,
   "styles": {
    "card": [
     {
      "background": "transparent"
     },
     {
      "box-shadow": "none"
     },
     {
      "border": "none"
     },
     {
      "height": "66px"
     }
    ]
   }
  },
  "ftv_key": {
   "template": "ftv_base"
  },
  "ftv_action": {
   "template": "ftv_base",
   "show_name": true,
   "styles": {
    "card": [
     {
      "height": "48px"
     }
    ],
    "name": [
     {
      "font-size": "12px"
     },
     {
      "color": "#CFE6F2"
     }
    ],
    "icon": [
     {
      "width": "20px"
     },
     {
      "color": "#8ADAF2"
     }
    ]
   }
  },
  "ftv_app": {
   "color_type": "card",
   "show_icon": false,
   "show_name": true,
   "styles": {
    "card": [
     {
      "background": "rgba(255,255,255,0.05)"
     },
     {
      "border-radius": "12px"
     },
     {
      "border": "none"
     },
     {
      "padding": "9px 4px 7px"
     },
     {
      "box-shadow": "inset 0 1px 0 rgba(255,255,255,0.05)"
     }
    ],
    "grid": [
     {
      "grid-template-areas": "\"pic\" \"n\""
     },
     {
      "grid-template-rows": "auto auto"
     },
     {
      "row-gap": "6px"
     }
    ],
    "name": [
     {
      "font-size": "10px"
     },
     {
      "color": "#A3B0BF"
     },
     {
      "line-height": 1.2
     },
     {
      "white-space": "normal"
     },
     {
      "overflow": "hidden"
     },
     {
      "max-height": "24px"
     }
    ],
    "custom_fields": {
     "pic": [
      {
       "justify-self": "center"
      }
     ]
    }
   },
   "extra_styles": "ha-card { transition: transform .1s ease, box-shadow .1s ease, background .1s ease; }\nha-card:active {\n  transform: scale(0.9);\n  background: rgba(79,195,232,0.18) !important;\n  box-shadow: 0 0 16px rgba(79,195,232,0.45) !important;\n}\n"
  }
 },
